# Backend: pi, and only pi. This Agent supports no other backend.
AGENT_BACKEND=pi

# Provider and model are injected at runtime and are never part of the Agent
# definition. The implementation is LLM-agnostic: switching the LLM means
# changing these lines and re-running the smoke, never changing code.
LLM_PROVIDER=gravarc-router
LLM_MODEL=kimi-k3
# Optional: a separate model for the three independent review gates.
LLM_REVIEW_MODEL=

# Provider credential. The variable name is derived from the provider id:
# "-" and "." become "_", the name is upper-cased, and "_API_KEY" is appended.
# For LLM_PROVIDER=gravarc-router that is GRAVARC_ROUTER_API_KEY.
# Produce the env file with:
#   accountctl docker-run --providers gravarc-router --env-file-only --out <path>
GRAVARC_ROUTER_API_KEY=

# Domain tool credential for Bohrium (LKM depth enrichment and PDF text).
# Not a backend and not an LLM provider.
BOHR_ACCESS_KEY=
