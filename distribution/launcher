#!/usr/bin/env bash
# Product launcher for __AGENT_NAME__. Backend: pi, and only pi.
#
# Two front doors, deliberately:
#
#   1. The deterministic control CLI (doctor/create/status/resume/validate).
#      Task production is a deterministic pipeline, not a conversation, so
#      these subcommands are dispatched to papersmith-cli before any model
#      wiring happens. They must keep working without provider credentials.
#   2. The pi session, for request clarification and explaining the contract.
#      Resources are loaded through pi's own loaders (--skill, --prompt-template,
#      --theme, --extension) from the paths declared in the runtime's
#      package.json, which is the single source of truth. Only the
#      identity/policy and the context files pi has no primitive for are
#      injected as system prompt, one --append-system-prompt segment per file
#      so provenance survives.
#
# Provider and model are never baked in. They arrive from --provider/--model or
# LLM_PROVIDER/LLM_MODEL and are passed through verbatim, so changing the LLM
# never requires touching this file or the runtime definition.
set -euo pipefail

bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
agent_home="$bin_dir/../lib/__AGENT_NAME__"
definition_dir="$agent_home/agent-definition"
[[ -d "$definition_dir" ]] && definition_dir="$(cd "$definition_dir" && pwd -P)"
manifest="$definition_dir/package.json"

fail() { printf '%s\n' "$*" >&2; exit 2; }

[[ -f "$manifest" ]] || fail "Agent resource manifest is missing: $manifest"

agent_environment_dir="$agent_home/environment"
if [[ -d "$agent_environment_dir/bin" ]]; then
  export PATH="$agent_environment_dir/bin:$PATH"
fi

backend="${AGENT_BACKEND:-${PAPERSMITH_BACKEND:-pi}}"
provider="${LLM_PROVIDER:-}"
model="${LLM_MODEL:-}"
mode="run"
tools_override="${AGENT_TOOLS:-}"
passthrough=()
domain=""

usage() {
  cat <<'EOF'
Usage: __AGENT_NAME__ [OPTIONS] [TASK]
       __AGENT_NAME__ doctor|create|status|resume|validate [ARGS...]
       __AGENT_NAME__ --tui [OPTIONS]

Backend: pi. This Agent supports no other backend.

Task production (deterministic control CLI):
  doctor      Report Python, pi discovery, document tools and capabilities.
  create      Produce Harbor paper-writing tasks from authorized sources.
  status      Read a run workspace without changing it.
  resume      Continue an interrupted run, reusing existing evidence.
  validate    Verify an acceptance receipt and assemble delivery.json.

Options:
  --provider NAME  Provider name (required for a model session; never defaulted).
  --model NAME     Model, optionally "provider/id".
  --tools LIST     Comma-separated tool allowlist override.
  --tui            Start pi's interactive interface.
  --backend NAME   Accepted only as "pi"; any other value is an error.
  -h, --help       Show this help.
  -v, --version    Show the installed Agent version.

Provider, model and credentials are supplied at run time and are never part of
the Agent definition. Real Harbor acceptance runs in a trusted worker outside
this Agent; a task is delivered only against a receipt showing oracle=1/nop=0.
EOF
}

while (($#)); do
  case "$1" in
    --backend|-b) backend="${2:?missing value for --backend}"; shift 2 ;;
    --provider) provider="${2:?missing value for --provider}"; shift 2 ;;
    --model|-m) model="${2:?missing value for --model}"; shift 2 ;;
    --tools) tools_override="${2:?missing value for --tools}"; shift 2 ;;
    --tui) mode="tui"; shift ;;
    --help|-h) usage; exit 0 ;;
    --version|-v)
      sed -n 's/.*"version":"\([^"]*\)".*/\1/p' "$agent_home/release-manifest.json" | head -n 1
      exit 0
      ;;
    doctor|create|status|resume|validate)
      domain="$1"; shift; break
      ;;
    --) shift; passthrough+=("$@"); break ;;
    *) passthrough+=("$1"); shift ;;
  esac
done

case "$backend" in
  pi|pi-coding-agent) backend="pi" ;;
  *) fail "unsupported backend: $backend (this Agent supports pi only)" ;;
esac

# ---------------------------------------------------------------------------
# Front door 1: the deterministic control CLI. Dispatched before provider and
# credential checks, because `doctor` and `status` are read-only and must be
# usable without a model. The pipeline's own model sessions enforce their own
# provider requirement at the point of use.
# ---------------------------------------------------------------------------
run_domain() {
  local cmd="$1"; shift
  # Forward launcher-level provider/model so the CLI's runtime injection sees
  # them even when they were given before the subcommand.
  [[ -n "$provider" ]] && export LLM_PROVIDER="$provider"
  [[ -n "$model" ]] && export LLM_MODEL="$model"
  local bundled="$agent_environment_dir/bin/papersmith-cli"
  if [[ -x "$bundled" ]]; then
    exec "$bundled" "$cmd" "$@"
  fi
  if command -v papersmith-cli >/dev/null 2>&1; then
    exec papersmith-cli "$cmd" "$@"
  fi
  fail "papersmith tools are not installed; run the installer first"
}

if [[ -n "$domain" ]]; then
  run_domain "$domain" "$@"
fi

# ---------------------------------------------------------------------------
# Front door 2: the pi session.
# ---------------------------------------------------------------------------
runtime_bin() {
  local name="$1"
  local bundled="$agent_home/runtimes/$name/node_modules/.bin/$name"
  if [[ -x "$bundled" ]]; then
    printf '%s\n' "$bundled"
  else
    command -v "$name" || true
  fi
}

pi_bin="$(runtime_bin pi)"
[[ -n "$pi_bin" ]] || fail "pi runtime is not installed"
command -v node >/dev/null 2>&1 || fail "node is required to read the Agent resource manifest"

[[ -n "$provider" ]] || fail "--provider or LLM_PROVIDER is required"
key_variable="$(printf '%s' "$provider" | tr '[:lower:]-.' '[:upper:]__')_API_KEY"
if [[ -z "${!key_variable:-}" && "${PI_AUTH_STORE:-}" != 1 ]]; then
  fail "$key_variable is required (or provide an explicit read-only pi auth store)"
fi
export PI_CODING_AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"

# ---------------------------------------------------------------------------
# Ambient discovery is closed for every resource type where the backend
# documents, or local testing proved, that an explicit load stays additive:
# --no-skills, --no-extensions, --no-prompt-templates, --no-context-files,
# --no-approve. --no-themes is NOT passed, because theme additivity could not
# be observed from a non-TUI mode and an unverified flag must not silently
# drop a declared resource.
#
# Manifest resolution. Every declared path must be a normalized relative path
# inside the definition root: absolute paths, ".." traversal, empty names,
# shell metacharacters, globs and symlinks are refused rather than sanitized.
# ---------------------------------------------------------------------------
read -r -d '' resolver <<'RESOLVER' || true
const fs = require("node:fs");
const path = require("node:path");

const root = fs.realpathSync(process.env.AGENT_DEFINITION_DIR);
const out = [];
const emit = (key, value) => out.push(key + "=" + value);
const die = (message) => {
  process.stderr.write("manifest error: " + message + "\n");
  process.exit(2);
};

const FORBIDDEN = /[\0\n\r`$;|&<>*?()\[\]{}!\\"']/;

function normalize(relative, label, expect) {
  if (typeof relative !== "string" || relative.trim() === "") {
    die(label + ": path must be a non-empty string");
  }
  if (FORBIDDEN.test(relative)) {
    die(label + ": path contains a forbidden character: " + JSON.stringify(relative));
  }
  if (relative.startsWith("/") || relative.startsWith("\\") || /^[A-Za-z]:/.test(relative)) {
    die(label + ": path must be relative: " + relative);
  }
  const parts = relative.split("/").filter((part) => part !== "" && part !== ".");
  if (parts.includes("..")) die(label + ": path must not traverse upward: " + relative);
  if (parts.length === 0) die(label + ": path resolves to the root itself: " + relative);
  const absolute = path.join(root, parts.join("/"));
  let cursor = absolute;
  while (cursor !== root && cursor !== path.dirname(cursor)) {
    let entry;
    try {
      entry = fs.lstatSync(cursor);
    } catch {
      die(label + ": path does not exist: " + relative);
    }
    if (entry.isSymbolicLink()) die(label + ": symlink is not allowed: " + relative);
    cursor = path.dirname(cursor);
  }
  const real = fs.realpathSync(absolute);
  if (real !== root && !real.startsWith(root + path.sep)) {
    die(label + ": path resolves outside the definition root: " + relative);
  }
  const stat = fs.statSync(real);
  if (expect === "file" && !stat.isFile()) die(label + ": expected a file: " + relative);
  if (expect === "dir" && !stat.isDirectory()) die(label + ": expected a directory: " + relative);
  return real;
}

function list(section, key, label) {
  const value = section[key];
  if (value === undefined) return [];
  if (!Array.isArray(value)) die(label + " must be an array");
  return value;
}

let manifest;
try {
  manifest = JSON.parse(fs.readFileSync(path.join(root, "package.json"), "utf8"));
} catch (error) {
  die("package.json is not readable JSON: " + error.message);
}
if (manifest.scripts && Object.keys(manifest.scripts).length > 0) {
  die("package.json must not declare npm lifecycle scripts");
}

const pi = manifest.pi;
if (!pi || typeof pi !== "object") die("package.json has no pi section");
const agent = manifest.agent;
if (!agent || typeof agent !== "object") die("package.json has no agent section");
if (agent.manifest_version !== 1) die("agent manifest_version must be 1");
if (agent.backend !== "pi") die("agent backend must be pi");

for (const entry of list(pi, "skills", "pi.skills")) {
  emit("PIARG", "--skill");
  emit("PIARG", normalize(entry, "pi.skills"));
}
for (const entry of list(pi, "prompts", "pi.prompts")) {
  emit("PIARG", "--prompt-template");
  emit("PIARG", normalize(entry, "pi.prompts"));
}
for (const entry of list(pi, "themes", "pi.themes")) {
  emit("PIARG", "--theme");
  emit("PIARG", normalize(entry, "pi.themes"));
}
for (const entry of list(pi, "extensions", "pi.extensions")) {
  emit("PIARG", "--extension");
  emit("PIARG", normalize(entry, "pi.extensions", "file"));
}

for (const entry of list(agent, "system_prompt", "agent.system_prompt")) {
  emit("SYSFILE", normalize(entry, "agent.system_prompt", "file"));
}
for (const entry of list(agent, "context", "agent.context")) {
  const resolved = normalize(entry, "agent.context");
  if (fs.statSync(resolved).isDirectory()) {
    const walk = (directory) => {
      for (const name of fs.readdirSync(directory).sort()) {
        const child = path.join(directory, name);
        if (fs.lstatSync(child).isSymbolicLink()) continue;
        if (fs.statSync(child).isDirectory()) walk(child);
        else if (name.endsWith(".md") && name !== "AGENTS.md") emit("CTXFILE", child);
      }
    };
    walk(resolved);
  } else {
    emit("CTXFILE", resolved);
  }
}

const tools = list(agent, "default_tools", "agent.default_tools");
if (tools.length === 0) die("agent.default_tools must not be empty");
for (const name of tools) {
  if (typeof name !== "string" || !/^[A-Za-z0-9_.-]+$/.test(name)) {
    die("agent.default_tools contains an invalid tool name: " + JSON.stringify(name));
  }
}
emit("TOOLS", tools.join(","));
emit("CAPS", list(agent, "capabilities", "agent.capabilities").join(","));
emit("NET", agent.network === "allow" ? "allow" : "deny");

process.stdout.write(out.join("\0") + "\0");
RESOLVER

pi_resource_args=()
system_prompt_files=()
context_files=()
manifest_tools=""
capabilities=""
network="deny"

while IFS= read -r -d '' record; do
  key="${record%%=*}"
  value="${record#*=}"
  case "$key" in
    PIARG) pi_resource_args+=("$value") ;;
    SYSFILE) system_prompt_files+=("$value") ;;
    CTXFILE) context_files+=("$value") ;;
    TOOLS) manifest_tools="$value" ;;
    CAPS) capabilities="$value" ;;
    NET) network="$value" ;;
    *) fail "unexpected manifest record: $key" ;;
  esac
done < <(AGENT_DEFINITION_DIR="$definition_dir" node -e "$resolver")

[[ -n "$manifest_tools" ]] || fail "the runtime manifest resolved no tool allowlist"

# Runtime posture. Defaults are restrictive; widening is explicit and per-run.
export PAPERSMITH_WORKSPACE="${PAPERSMITH_WORKSPACE:-$PWD}"
export PAPERSMITH_CAPABILITIES="${PAPERSMITH_CAPABILITIES:-$capabilities}"
export PAPERSMITH_NETWORK="${PAPERSMITH_NETWORK:-$network}"
export PAPERSMITH_PI_BIN="${PAPERSMITH_PI_BIN:-$pi_bin}"
export PAPERSMITH_PROVIDER="${PAPERSMITH_PROVIDER:-$provider}"
[[ -n "$model" ]] && export PAPERSMITH_MODEL="${PAPERSMITH_MODEL:-$model}"

system_prompt_args=()
for file in "${system_prompt_files[@]}"; do
  system_prompt_args+=(--append-system-prompt "$(cat "$file")")
done
for file in "${context_files[@]}"; do
  relative="${file#"$definition_dir"/}"
  system_prompt_args+=(--append-system-prompt "$(printf '# Runtime context: %s\n\n' "$relative"; cat "$file")")
done

pi_args=(
  --provider "$provider"
  --no-context-files
  --no-approve
  --no-skills
  --no-extensions
  --no-prompt-templates
  --tools "${tools_override:-$manifest_tools}"
  "${pi_resource_args[@]}"
  "${system_prompt_args[@]}"
)
[[ -n "$model" ]] && pi_args+=(--model "$model")
[[ -n "${AGENT_THEME:-}" ]] && pi_args+=(--use-theme "$AGENT_THEME")
[[ "${AGENT_PI_OFFLINE:-}" == 1 ]] && pi_args+=(--offline)

case "${AGENT_OUTPUT_FORMAT:-}" in
  "") ;;
  text|json|rpc) pi_args+=(--mode "$AGENT_OUTPUT_FORMAT") ;;
  *) fail "unsupported AGENT_OUTPUT_FORMAT: $AGENT_OUTPUT_FORMAT (expected text, json or rpc)" ;;
esac

if [[ "$mode" == tui || ${#passthrough[@]} -eq 0 ]]; then
  exec "$pi_bin" "${pi_args[@]}" -- "${passthrough[@]}"
fi

exec "$pi_bin" "${pi_args[@]}" --print --no-session -- "${passthrough[@]}"
