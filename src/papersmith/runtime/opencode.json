{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "papersmith",
  "agent": {
    "papersmith": {
      "description": "An evidence-aware assistant for academic manuscript drafting and review.",
      "prompt": "{file:./identity.md}",
      "tools": {
        "skill": true
      }
    }
  },
  "skills": ["./skills"],
  "instructions": ["./knowledge/*.md", "./workflows/*.md"],
  "share": "disabled",
  "autoupdate": false
}
